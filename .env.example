# CanonForge environment configuration — copy to .env and fill in.
# .env is gitignored and must NEVER be committed.

# AI provider selection (default: noop, which requires no key)
CANONFORGE_DEFAULT_PROVIDER=noop

# Provider API keys (only needed when using a real provider)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Database URL (default: sqlite:///canonforge.db for v0.1)
# CANONFORGE_DB=sqlite:///canonforge.db
